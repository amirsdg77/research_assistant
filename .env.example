# --- API keys (required) ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Model routing ---
PLANNER_MODEL=gpt-4o
EXECUTOR_MODEL=gpt-4o-mini
SYNTHESIZER_MODEL=gpt-4o
VERIFIER_MODEL=gpt-4o-mini
SUMMARIZER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
# Inside docker compose, host is `postgres`; for local dev override to `localhost`.
POSTGRES_URL=postgresql+asyncpg://agent:agent@postgres:5432/agent

# Chroma host/port are container-internal. Host machine reaches Chroma on :8001
# (see docker-compose.yml port mapping), but the app talks to it on :8000 inside the network.
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Runtime knobs ---
LOG_LEVEL=INFO
MAX_TOOL_ITERATIONS_PER_TASK=6
TOKEN_BUDGET_PER_CALL=8000
MAX_UPLOAD_BYTES=10485760
MAX_DOCS_PER_SESSION=10
MAX_CONCURRENT_SESSIONS=4
